# Copy to the server as /etc/investment-tools/env, root-owned, mode 600.
# Never fill this file in and never commit a filled-in copy.

# comdirect developer self-service (separate from online banking)
COMDIRECT_CLIENT_ID=
COMDIRECT_CLIENT_SECRET=

# comdirect online banking: Zugangsnummer and PIN
COMDIRECT_USERNAME=
COMDIRECT_PASSWORD=

# Telegram bot token from BotFather, and the one chat allowed to run /check
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Defaults to /etc/investment-tools/allocation.toml
ALLOCATION_PATH=
