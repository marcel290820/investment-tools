# Copy to ~/.config/investment-tools/env, mode 600.
# Never fill this file in and never commit a filled-in copy.

# comdirect developer self-service (separate from online banking)
COMDIRECT_CLIENT_ID=
COMDIRECT_CLIENT_SECRET=

# comdirect online banking: Zugangsnummer and PIN
COMDIRECT_USERNAME=
COMDIRECT_PASSWORD=

# Only `investment-tools bot` reads these. `investment-tools check` runs
# without them. Bot token from BotFather, and the one chat allowed to run /check.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Defaults to ~/.config/investment-tools/allocation.toml
ALLOCATION_PATH=

# Optional. Defaults to ~/.local/state/investment-tools/history.db
HISTORY_DB_PATH=
